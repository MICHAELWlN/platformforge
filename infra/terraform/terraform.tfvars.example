# Copy to terraform.tfvars and replace the placeholders.
# terraform.tfvars is gitignored. Do not put keys, tokens, or kubeconfigs here.
# 203.0.113.10 is a documentation address (TEST-NET-3). Replace it with the
# operator's current public IPv4 before any apply. A /32 is the expected value.

project_id = "your-gcp-project-id"
region     = "us-central1"
zone       = "us-central1-a"

master_authorized_cidrs = [
  {
    cidr_block   = "203.0.113.10/32"
    display_name = "operator"
  }
]
