.venv/
# Downloaded tool binaries (e.g. istioctl); see docs/ISTIO.md
.tools/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Never commit credentials or local cluster config
*.kubeconfig
kubeconfig*
.env
.env.*
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
*.tfplan
*.tfplan.*
tfplan
tfplan.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info
infra/terraform/terraform.tfvars
infra/terraform/*.auto.tfvars
!infra/terraform/terraform.tfvars.example
# Real image digests are written here after a registry publish. The example stays tracked.
deploy/gke/image-lock.yaml

# Any tfvars, not only the root file. Examples stay tracked.
*.tfvars
!*.tfvars.example

# Private keys, tokens, and local credential files
*.pem
*.p12
*.pfx
*.key
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials.json
*-credentials.json
*service-account*.json
*kubeconfig*

# Generated recordings and local caches
recordings/
*.mp4
*.mov
*.webm
*.mkv
.mypy_cache/
.cache/
# Local Cursor config may contain an absolute path. The example is tracked.
.cursor/*
!.cursor/mcp.example.json
